# Variables de la stack ki-chat.
#
# En ligne de commande : copie ce fichier en `.env` à côté du
# docker-compose.yml (`cp stack.env.example .env`) et remplis-le.
# Dans Portainer : recopie ces clés dans « Environment variables » au moment
# de créer la stack — ne dépose pas ce fichier sur le serveur.

# OBLIGATOIRE — code d'invitation : quiconque le connaît peut se créer un
# compte. Prends-en un long et aléatoire, par exemple :
#   openssl rand -base64 24
# Une fois ton propre compte créé (le premier compte devient admin), tu peux
# générer des codes à usage unique depuis le panneau ♛ Admin et laisser
# celui-ci de côté.
KI_TOKEN=change_moi_vraiment

# Version de l'image. `latest` suit `main` ; épingle un numéro (0.1.1) si tu
# veux décider toi-même quand bouger.
KI_VERSION=latest

# Ports publiés sur l'hôte. À ne changer que s'ils sont déjà pris : les
# clients devront alors indiquer `hôte:port` au lieu de `hôte`.
KI_UDP_PORT=9987
KI_HTTP_PORT=8080

# Bornes du partage de fichiers. Sans elles, le dossier des envois grandit
# jusqu'à saturer le disque de la machine. Une purge passe au démarrage puis
# toutes les heures : d'abord ce qui a dépassé l'âge, puis les plus anciens
# tant que le plafond reste franchi. Mettre 0 lève la limite correspondante.
KI_FILES_MAX_BYTES=2147483648

# Clé d'API HenrikDev (https://api.henrikdev.xyz/dashboard/) pour les fiches
# VALORANT des membres. Elle ne quitte jamais le serveur. Laisse vide pour
# fermer les liaisons de compte Riot ; tout le reste fonctionne sans.
KI_HENRIK_KEY=
KI_FILES_TTL_DAYS=30

# Plafond d'un fichier envoyé par morceaux (les vidéos partagées), en Mo.
# Les vidéos sont refaites en MP4 lisible partout : la source est effacée
# après conversion, seul le résultat compte dans KI_FILES_MAX_BYTES.
KI_FILES_MAX_FILE_MB=512

# Les clips partagés (les trente dernières secondes de jeu, à la touche) ont
# leur stock à part, data/clips/ : un clip pèse dix fois une photo, une
# soirée de clips ne doit pas effacer les partages de la semaine. La source
# reste après conversion (l'atelier en a besoin) : compte deux fois le poids
# du clip. Mêmes règles de purge que les fichiers.
KI_CLIPS_MAX_BYTES=8589934592
KI_CLIPS_TTL_DAYS=60

# Verbosité des journaux (info, debug, trace).
RUST_LOG=info
