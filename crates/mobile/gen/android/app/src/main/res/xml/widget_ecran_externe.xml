<?xml version="1.0" encoding="utf-8"?>
<!-- Le widget de l'écran externe des Galaxy Z Flip (« Flex Window ») : la
     taille et la catégorie que demande Samsung (352 × 339 dp, l'écran externe
     entier du Flip 5 et du Flip 6). Jamais de mise à jour périodique : la page
     pousse l'état (voir EcranExterne.kt). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="352dp"
    android:minHeight="339dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="keyguard"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_ecran_externe"
    android:previewLayout="@layout/widget_ecran_externe"
    android:description="@string/widget_description" />
