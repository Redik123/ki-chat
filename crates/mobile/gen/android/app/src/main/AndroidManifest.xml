<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vocal : micro (demandé au lancement, voir MainActivity) et mode
         communication de l'audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Le vocal écran éteint : service au premier plan de type micro,
         processeur et Wi-Fi gardés éveillés (voir VocalService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Rester connecté hors vocal (option des réglages) : aucun type
         standard ne convient à une messagerie sans service de push. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Les notifications de messages et de mentions. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Les mises à jour depuis l'appli (la release GitHub, vérifiée). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ki_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- « density » : l'écran externe d'un Flip n'a pas la densité de
             l'écran intérieur. Sans elle, passer de l'un à l'autre recréerait
             l'activité, et la page rechargée rouvrirait une session neuve,
             hors du vocal. Avec elle, l'activité suit (voir
             MainActivity.onConfigurationChanged). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
        <receiver android:name=".InstallRecepteur" android:exported="false" />
        <!-- Le widget de l'écran externe des Galaxy Z Flip (Flex Window) : la
             recette de Samsung, deux meta-data dont la seconde l'envoie sur
             l'écran externe (voir EcranExterne.kt). -->
        <receiver
          android:name=".EcranExterneWidget"
          android:exported="false"
          android:label="@string/widget_nom">
          <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
          </intent-filter>
          <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_ecran_externe" />
          <meta-data
            android:name="com.samsung.android.appwidget.provider"
            android:resource="@xml/widget_ecran_externe_samsung" />
        </receiver>
        <!-- Ses boutons, et ceux de la notification du vocal. -->
        <receiver android:name=".ActionVocalRecepteur" android:exported="false" />
        <service
          android:name=".VocalService"
          android:exported="false"
          android:foregroundServiceType="microphone|specialUse">
          <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Messagerie auto-hébergée : garder la connexion au serveur du groupe pour recevoir les messages" />
        </service>
    </application>
</manifest>
