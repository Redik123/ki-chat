# Artefacts de compilation
/target

# Données du serveur : comptes (hachages Argon2id), historique des salons,
# fichiers partagés, identité du serveur — et surtout la CLÉ PRIVÉE TLS
# générée au premier démarrage. Rien de tout ça n'a sa place dans le dépôt.
/data

# Sorties de l'installeur, et l'icône que build.rs y dépose au passage
/installer/Output
/installer/*.ico

# Variables de la stack Docker : c'est là que vit le code d'invitation.
# Le modèle versionné est deploy/stack.env.example.
/deploy/.env

# Effets sonores : fichiers audio tiers, dont les droits de redistribution
# ne sont pas établis. Le dépôt étant public, ils restent en local en
# attendant d'être remplacés par des sons sous licence libre.
/sound effect/

# Journaux d'exécution
*.log
*.err
*.out

# État local des éditeurs
/.vs
.idea/
.vscode/

# Outillage local de session : réglages et copies de travail des agents.
/.claude/
